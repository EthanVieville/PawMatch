# Copier ce fichier en .env et remplir les valeurs

# ── Base de données PostgreSQL ────────────────────────────────────────────────
# En local (Docker) : postgres est le nom du service docker-compose
DATABASE_URL=postgresql://pawmatch:pawmatch@postgres:5432/pawmatch
# En local (sans Docker) : remplacer postgres par localhost
# DATABASE_URL=postgresql://pawmatch:pawmatch@localhost:5432/pawmatch

# ── Frontend ──────────────────────────────────────────────────────────────────
API_URL=http://api:8000

# ── API ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_SOURCE=la-spa
MAX_PAGES=10
NUM_WORKERS=4

# ── AWS (à configurer au moment du déploiement cloud) ────────────────────────
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=pawmatch-data
# ECR_REGISTRY=123456789012.dkr.ecr.eu-west-1.amazonaws.com
# DATABASE_URL=postgresql://pawmatch:<password>@<rds-endpoint>:5432/pawmatch
