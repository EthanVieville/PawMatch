# Copier ce fichier en .env et remplir les valeurs

# ── Base de données PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://pawmatch:pawmatch@postgres:5432/pawmatch

# ── Frontend ──────────────────────────────────────────────────────────────────
API_URL=http://api:8000

# ── API ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_SOURCE=la-spa
MAX_PAGES=10
NUM_WORKERS=4

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# BEDROCK_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# ── LLMOps Admin Dashboard ────────────────────────────────────────────────────
# Accès : http://localhost:8000/admin?token=<ADMIN_TOKEN>
# Via SSH tunnel : ssh -L 8001:localhost:8000 ec2-user@<ip> puis localhost:8001/admin?token=...
ADMIN_TOKEN=change_me_in_production
